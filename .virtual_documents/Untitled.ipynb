def extraer_caracteristicas(señal, fs, nombre_registro):
    """
    Extrae todas las características de una señal ECG
    
    Parámetros:
    - señal: señal ECG (array)
    - fs: frecuencia de muestreo (Hz)
    - nombre_registro: identificador del registro
    
    Retorna:
    - dict con todas las características calculadas
    """
    
    caracteristicas = {}
    caracteristicas['Registro'] = nombre_registro
    
    # Asegurar que la señal es un array numpy
    señal = np.array(señal)
    
    # ============ ESTADÍSTICAS ============
    caracteristicas['Media'] = np.mean(señal)
    caracteristicas['Mediana'] = np.median(señal)
    
    # Moda (usando histograma para datos continuos)
    hist, bins = np.histogram(señal, bins=100)
    bin_center = (bins[:-1] + bins[1:]) / 2
    caracteristicas['Moda'] = bin_center[np.argmax(hist)]
    
    caracteristicas['Máximo'] = np.max(señal)
    caracteristicas['Mínimo'] = np.min(señal)
    caracteristicas['Varianza'] = np.var(señal)
    caracteristicas['Desviación_Estd'] = np.std(señal)
    caracteristicas['Rango'] = np.max(señal) - np.min(señal)
    caracteristicas['Percentil_25'] = np.percentile(señal, 25)
    caracteristicas['Percentil_75'] = np.percentile(señal, 75)
    
    # ============ CARACTERÍSTICAS DE FORMA ============
    caracteristicas['Curtosis'] = stats.kurtosis(señal)
    caracteristicas['Asimetría'] = stats.skew(señal)
    
    # ============ CARACTERÍSTICAS ENERGÉTICAS ============
    # RMS (Root Mean Square)
    caracteristicas['RMS'] = np.sqrt(np.mean(señal**2))
    
    # Energía (suma de cuadrados)
    caracteristicas['Energía'] = np.sum(señal**2)
    
    # Potencia (energía / duración)
    duracion = len(señal) / fs
    caracteristicas['Potencia'] = caracteristicas['Energía'] / duracion
    
    # ============ CARACTERÍSTICAS TEMPORALES ============
    # Cruces por cero (cero como media)
    media_señal = np.mean(señal)
    cruces_cero = np.where(np.diff(np.sign(señal - media_señal)))[0]
    caracteristicas['Cruces_por_Cero'] = len(cruces_cero)
    
    # Picos (encontrar máximos y mínimos locales)
    # Usamos scipy para encontrar picos
    picos_max, _ = signal.find_peaks(señal, height=np.std(señal)*0.5)
    picos_min, _ = signal.find_peaks(-señal, height=np.std(señal)*0.5)
    
    if len(picos_max) > 0:
        caracteristicas['Pico_Máximo'] = np.max(señal[picos_max])
        caracteristicas['Posición_Pico_Máximo'] = picos_max[np.argmax(señal[picos_max])] / fs
    else:
        caracteristicas['Pico_Máximo'] = np.nan
        caracteristicas['Posición_Pico_Máximo'] = np.nan
    
    if len(picos_min) > 0:
        caracteristicas['Pico_Mínimo'] = np.min(señal[picos_min])
        caracteristicas['Posición_Pico_Mínimo'] = picos_min[np.argmin(señal[picos_min])] / fs
    else:
        caracteristicas['Pico_Mínimo'] = np.nan
        caracteristicas['Posición_Pico_Mínimo'] = np.nan
    
    # ============ CARACTERÍSTICAS FRECUENCIALES (FFT) ============
    # Calcular FFT
    n = len(señal)
    fft_signal = fft(señal)
    frecuencias = fftfreq(n, 1/fs)
    
    # Tomar solo la mitad positiva del espectro
    frecuencias_pos = frecuencias[:n//2]
    magnitud_fft = np.abs(fft_signal[:n//2])
    
    # Frecuencia dominante
    idx_max = np.argmax(magnitud_fft[1:]) + 1  # Ignorar DC
    caracteristicas['Frecuencia_Dominante'] = frecuencias_pos[idx_max]
    caracteristicas['Magnitud_Máxima'] = magnitud_fft[idx_max]
    
    # Energía espectral (suma de magnitudes al cuadrado)
    caracteristicas['Energía_Espectral'] = np.sum(magnitud_fft**2)
    
    # Características adicionales del espectro
    caracteristicas['Frecuencia_Media'] = np.sum(frecuencias_pos * magnitud_fft) / np.sum(magnitud_fft)
    caracteristicas['Frecuencia_Mediana'] = frecuencias_pos[np.searchsorted(np.cumsum(magnitud_fft), np.sum(magnitud_fft)/2)]
    
    # Ancho de banda (desviación estándar de la frecuencia)
    if np.sum(magnitud_fft) > 0:
        frec_promedio = caracteristicas['Frecuencia_Media']
        var_frec = np.sum((frecuencias_pos - frec_promedio)**2 * magnitud_fft) / np.sum(magnitud_fft)
        caracteristicas['Ancho_Banda'] = np.sqrt(var_frec)
    else:
        caracteristicas['Ancho_Banda'] = np.nan
    
    return caracteristicas

