# Calcular FFT de ambas señales
def calcular_fft(señal, fs):
    n = len(señal)
    fft_signal = fft(señal)
    frecuencias = fftfreq(n, 1/fs)
    frecuencias_pos = frecuencias[:n//2]
    magnitud = np.abs(fft_signal[:n//2])
    return frecuencias_pos, magnitud

