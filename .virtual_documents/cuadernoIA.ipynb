# Visualizar los canales en un subplot
fig, ax = plt.subplots(1,3, figsize=(12,4))
ax[0].imshow(R, cmap='gray')
ax[0].set_title('Red')
ax[0].axis('off')
ax[1].imshow(G, cmap='gray')
ax[1].set_title('Green')
ax[1].axis('off')
ax[2].imshow(B, cmap='gray')
ax[2].set_title('Blue')
ax[2].axis('off')
plt.suptitle('Canales RGB')
plt.show()


# 3. CONVERTIR BGR A RGB
