# Herramientas para dividir datos y realizar validación cruzada
from sklearn.model_selection import (
    cross_val_predict,  # Genera predicciones mediante validación cruzada
    cross_val_score,    # Calcula métricas usando validación cruzada
    train_test_split,   # Divide datos en entrenamiento y prueba
    KFold               # Define particiones K-Fold para validación cruzada
)

# Funciones de preprocesamiento de datos
# (normalización, escalado, codificación, etc.)
from sklearn import preprocessing

# Importa funciones personalizadas definidas en el archivo
# evaluacion_funciones.py
from evaluacion_funciones import *



# Carga de datos.
# Cargamos el conjunto de datos Iris (un dataset clásico de Machine Learning)
datos = load_iris()

# EXPLICACIÓN DEL DATASET IRIS:
# - Es un dataset de flores creado por Ronald Fisher en 1936
# - Contiene 150 muestras de 3 especies de flores Iris:
#   * Iris Setosa (clase 0)
#   * Iris Versicolor (clase 1)  
#   * Iris Virginica (clase 2)
# - Cada muestra tiene 4 características (features):
#   * Longitud del sépalo (sepal length) en cm
#   * Ancho del sépalo (sepal width) en cm
#   * Longitud del pétalo (petal length) en cm  ← IMPORTANTE
#   * Ancho del pétalo (petal width) en cm      ← IMPORTANTE
# - Es un problema de CLASIFICACIÓN MULTICLASE (3 clases)

# SELECCIÓN DE ATRIBUTOS (Feature Selection)
# datos.data contiene todas las características (150 muestras × 4 características)
# [:,2:] es un slice de NumPy que selecciona columnas específicas:
X = datos.data[:,2:]  # Utilizamos solo 2 atributos.

# DESGLOSE DE LA NOTACIÓN [:,2:]:
# - Primer ':' -> Selecciona TODAS las filas (las 150 muestras)
# - '2:'     -> Selecciona las columnas DESDE el índice 2 HASTA el final
# 
# Índices de las columnas en datos.data:
# ┌─────────┬──────────────┬─────────────────┬──────────────────┬─────────────────┐
# │ Índice  │ 0            │ 1               │ 2                │ 3               │
# ├─────────┼──────────────┼─────────────────┼──────────────────┼─────────────────┤
# │ Feature │ Longitud sep │ Ancho sep       │ Longitud pétalo  │ Ancho pétalo    │
# └─────────┴──────────────┴─────────────────┴──────────────────┴─────────────────┘
#
# Con [:,2:] seleccionamos:
# - Columna 2: Longitud del pétalo (petal length)
# - Columna 3: Ancho del pétalo (petal width)
#
# Resultado: X tendrá dimensiones (150, 2)

# ¿POR QUÉ SOLO 2 ATRIBUTOS?
# 1. VISUALIZACIÓN: Con 2 características podemos graficar en 2D (plano)
# 2. SIMPLICIDAD: Más fácil de entender y visualizar los resultados
# 3. DEMOSTRACIÓN: Las características de los pétalos son muy discriminativas
#    (separan muy bien las 3 clases de Iris)

# VARIABLE OBJETIVO (Target/Labels)
y = datos.target  # Extraemos las etiquetas/clases de las flores
# datos.target contiene:
# - 50 muestras de clase 0 (Setosa)
# - 50 muestras de clase 1 (Versicolor)  
# - 50 muestras de clase 2 (Virginica)

# IMPRIMIR DIMENSIONES PARA VERIFICAR
print(np.shape(X))  # Mostrará: (150, 2)
# Esto confirma que tenemos 150 muestras con 2 características cada una

# EJEMPLO VISUAL DE CÓMO SE VE X (primeras 5 muestras):
# ┌─────────┬──────────────────┬─────────────────┐
# │ Muestra │ Long. Pétalo (cm)│ Ancho Pétalo (cm)│
# ├─────────┼──────────────────┼─────────────────┤
# │ 0       │ 1.4              │ 0.2             │ (Setosa)
# │ 1       │ 1.4              │ 0.2             │ (Setosa)
# │ 2       │ 1.3              │ 0.2             │ (Setosa)
# │ 3       │ 1.5              │ 0.2             │ (Setosa)
# │ 4       │ 1.4              │ 0.2             │ (Setosa)
# └─────────┴──────────────────┴─────────────────┘

# VENTAJAS DE ESTA SELECCIÓN:
# ✓ Reduce la dimensionalidad (de 4 a 2 características)
# ✓ Permite visualización en 2D
# ✓ Las características de pétalos discriminan muy bien las especies
# ✓ Menor riesgo de overfitting
# ✓ Cálculos más rápidos

# DESVENTAJAS:
# ✗ Perdemos información de los sépalos
# ✗ Podríamos perder algo de precisión (aunque en Iris no mucho)

# NOTA: Si quisiéramos TODAS las características, usaríamos:
# X = datos.data  # Esto daría (150, 4)

# Si quisiéramos solo una característica:
# X = datos.data[:, 2:3]  # Solo longitud del pétalo (150, 1)

# Si quisiéramos las primeras 3 características:
# X = datos.data[:, :3]  # (150, 3)


# Métricas de evaluación.
# Creamos un diccionario que almacena diferentes funciones de evaluación
# Cada clave es el nombre de la métrica y el valor es la función que la calcula
metricas = {
    # ACCURACY (Exactitud)
    # Proporción de predicciones correctas sobre el total de predicciones
    # Fórmula: (VP + VN) / (VP + VN + FP + FN)
    # Es buena cuando las clases están balanceadas
    'ACC': metrics.accuracy_score,
    
    # PRECISION (Precisión)
    # De todas las predicciones positivas, ¿cuántas fueron realmente correctas?
    # Fórmula: VP / (VP + FP)
    # Usa lambda para crear una función anónima que llama a precision_score
    # average='micro': Calcula la precisión global contando totales de VP y FP
    # Útil para problemas multiclase (como Iris con 3 clases)
    'PREC': lambda y_true, y_pred:
            metrics.precision_score(y_true, y_pred, average='micro'),
    
    # RECALL (Sensibilidad o Tasa de Verdaderos Positivos)
    # De todas las instancias que realmente son positivas, ¿cuántas identificamos?
    # Fórmula: VP / (VP + FN)
    # average='micro': Agrega contribuciones de todas las clases para calcular el recall global
    'RECALL': lambda y_true, y_pred:
            metrics.recall_score(y_true, y_pred, average='micro'),
    
    # F1-SCORE (Media armónica entre precisión y recall)
    # Fórmula: 2 * (Precision * Recall) / (Precision + Recall)
    # Útil cuando hay desbalanceo de clases (no es el caso de Iris, pero es buena práctica)
    # Valores cercanos a 1 indican buen equilibrio entre precisión y recall
    'F1': lambda y_true, y_pred:
            metrics.f1_score(y_true, y_pred, average='micro')
}


