# Ejercicio individual
# Obtener una máscara con la imagen del rayo azul mediante segmentación por espacio de color
import numpy as np
import cv2
import matplotlib.pyplot as plt

# Función para extraer los colores secundarios
def convert_to_CMYK(rgb_p):
    with np.errstate(invalid='ignore', divide='ignore'):
        K = 1 - np.max(rgb_p, axis=2)
        C = (1 - rgb_p[:,:,0] - K) / (1 - K)
        M = (1 - rgb_p[:,:,1] - K) / (1 - K)
        Y = (1 - rgb_p[:,:,2] - K) / (1 - K)
        CMYK = (np.dstack((C, M, Y, K)) * 255).astype('uint8')
    return CMYK

# Leer la imagen
img = cv2.imread('images/images/figuras.png')
rgb = cv2.cvtColor(img, cv2.COLOR_BGR2RGB)
rgb_p = rgb.astype('uint8') / 255

# Extraer los colores secundarios
CMYK = convert_to_CMYK(rgb_p)

# Extraer los canales por separado
C, M, Y, K = cv2.split(CMYK)
C = C.astype('uint8')

# Calcular la máscara de la figura del rayo
# El rayo azul tendrá valores altos en el canal C (cyan)
# Aplicamos un umbral para segmentar el rayo
_, mascara_rayo = cv2.threshold(C, 180, 255, cv2.THRESH_BINARY)

# Opcional: Limpiar la máscara con operaciones morfológicas
kernel = np.ones((5,5), np.uint8)
mascara_rayo = cv2.morphologyEx(mascara_rayo, cv2.MORPH_CLOSE, kernel)  # Cierra huecos
mascara_rayo = cv2.morphologyEx(mascara_rayo, cv2.MORPH_OPEN, kernel)   # Elimina ruido

# También podrías combinar con el canal M para mejor precisión
_, M_thresh = cv2.threshold(M, 150, 255, cv2.THRESH_BINARY_INV)  # El azul tiene bajo magenta
mascara_combinada = cv2.bitwise_and(mascara_rayo, M_thresh)

# Visualizar la máscara
plt.figure(figsize=(12, 4))

plt.subplot(1, 3, 1)
plt.imshow(rgb)
plt.title('Imagen original')
plt.axis('off')

plt.subplot(1, 3, 2)
plt.imshow(mascara_rayo, cmap='gray')
plt.title('Máscara del rayo (canal C)')
plt.axis('off')

plt.subplot(1, 3, 3)
plt.imshow(mascara_combinada, cmap='gray')
plt.title('Máscara mejorada (C + M)')
plt.axis('off')

plt.tight_layout()
plt.show()

# Mostrar solo la región del rayo
rayo_segmentado = cv2.bitwise_and(rgb, rgb, mask=mascara_combinada)
plt.figure()
plt.imshow(rayo_segmentado)
plt.title('Rayo azul segmentado')
plt.axis('off')
plt.show()





