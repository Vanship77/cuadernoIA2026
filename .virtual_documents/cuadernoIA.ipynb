# Creación aleatoria de datos
import numpy as np
X = np.array([0.5, 23, 0.3, 4.5, 0.3, 0.5,
-28, -50, 60, -100, -10, -11, 13, 19, 1, 9])
print("Datos:", X)


# Medidas de tendencia central
from scipy import stats
media = np.mean(X)
mediana = np.median(X)
moda, _ = stats.mode(X, keepdims=True)  # Corregido: añadido keepdims=True para evitar warning
print("=== MEDIDAS DE TENDENCIA CENTRAL ===")
print('media: ', media)
print('mediana: ', mediana)
print('moda :', moda[0] if hasattr(moda, '__len__') else moda)  # Mejor presentación


# Medidas de posición
Q1 = np.percentile(X, 25)
Q3 = np.percentile(X, 75)
RIC = Q3 - Q1
lim_inf = Q1 - 1.5*RIC
lim_sup = Q3 + 1.5*RIC
print("=== MEDIDAS DE POSICIÓN ===")
print('RIC :', RIC)
print('limite inferior :', lim_inf)
print('limite superior :', lim_sup)


# Dibuja el diagrama de box and whiskers y determina visualmente el número de outliers
import matplotlib.pyplot as plt
plt.figure(figsize=(8, 6))
plt.boxplot(X)
plt.grid()
plt.title("Diagrama de caja y bigotes")
plt.ylabel("Valores")
plt.show()


# Contar outliers visualmente (para ayudar al ejercicio)
outliers = X[(X < lim_inf) | (X > lim_sup)]
print(f"Número de outliers detectados: {len(outliers)}")
print(f"Outliers: {outliers}")
print()


# Medidas de dispersión
desvest = np.std(X, ddof=0)  # ddof=0 para desviación poblacional
print("=== MEDIDAS DE DISPERSIÓN ===")
print('Desviación típica: ', desvest)
print('Varianza: ', desvest**2)


# Medidas de distribución
asimetria = stats.skew(X)
curtosis = stats.kurtosis(X, fisher=True)
print("=== MEDIDAS DE DISTRIBUCIÓN ===")
print('Asimetría ', np.round(asimetria, 4))
print('Curtosis ', np.round(curtosis, 4))

# CORREGIDO: añadida indentación correcta
if curtosis > 0:
    print('Distribución Leptocúrtica (más puntiaguda que la normal)')
elif curtosis < 0:
    print('Distribución Platicúrtica (más aplanada que la normal)')
else:
    print('Distribución Mesocúrtica (similar a la normal)')
print()


# Cargar el set de datos de Iris
from sklearn import datasets
from scipy.stats import skew, kurtosis

iris = datasets.load_iris()
X = iris.data
y = iris.target

print("=== ANÁLISIS DEL DATASET IRIS ===")

# ¿Qué tipo de asimetría se observa en la variable "longitud del pétalo"?
longitud_petalo = X[:, 2]  # índice 2 = petal length (cm)
asimetria = skew(longitud_petalo)
print(f"\n--- Longitud del pétalo ---")
print(f"Asimetría: {asimetria:.4f}")
if asimetria > 0:
    print("→ La variable presenta asimetría POSITIVA (sesgo hacia la derecha)")
    print("  (La mayoría de valores están a la izquierda, cola larga a la derecha)")
elif asimetria < 0:
    print("→ La variable presenta asimetría NEGATIVA (sesgo hacia la izquierda)")
else:
    print("→ La variable tiene una distribución SIMÉTRICA")
# ¿A qué tipo de distribución se ajusta la variable "ancho del sépalo", según su curtosis?
ancho_sepalo = X[:, 1]  # índice 1 = sepal width (cm)
curt = kurtosis(ancho_sepalo)
print(f"\n--- Ancho del sépalo ---")
print(f"Curtosis: {curt:.4f}")
if curt > 0:
    print("→ La distribución es LEPTOCÚRTICA")
    print("  (Más puntiaguda que la normal, colas más pesadas)")
elif curt < 0:
    print("→ La distribución es PLATICÚRTICA")
    print("  (Más aplanada que la normal, colas más ligeras)")
else:
    print("→ La distribución es MESOCÚRTICA")
    print("  (Similar a la distribución normal)")
print()


# EJERCICIO EXTRA SOBRE EL DATASET DE IRIS
# Extraer la media y la desviación típica de cada variable en función de la clase y representarlo en un gráfico (plt.errorbar)
print("=== GRÁFICO DE MEDIAS Y DESVIACIONES POR CLASE ===")

# Nombres de variables
variables = iris.feature_names

# Clases
clases = np.unique(y)

# Crear figura
plt.figure(figsize=(12, 6))

# Recorrer cada clase
for clase in clases:
    # Filtrar datos por clase
    datos_clase = X[y == clase]
    
    # Calcular media
    media = np.mean(datos_clase, axis=0)
    
    # Calcular desviación típica
    desviacion = np.std(datos_clase, axis=0)
    
    # Graficar con barras de error
    plt.errorbar(
        range(len(variables)),
        media,
        yerr=desviacion,
        marker='o',
        capsize=8,  # Aumentado para mejor visibilidad
        capthick=2,
        elinewidth=1.5,
        markersize=8,
        label=iris.target_names[clase]
    )
    # Configuración del gráfico
plt.xticks(range(len(variables)), variables, rotation=15, ha='right')
plt.ylabel("Valores (cm)")
plt.xlabel("Características")
plt.title("Media y desviación típica por clase - Dataset Iris", fontsize=14, fontweight='bold')
plt.legend()
plt.grid(True, alpha=0.3)
plt.tight_layout()
plt.show()


# Información adicional útil
print("\n=== RESUMEN ADICIONAL ===")
print(f"Dimensiones del dataset Iris: {X.shape}")
print(f"Número de muestras: {X.shape[0]}")
print(f"Número de características: {X.shape[1]}")
print(f"Clases: {iris.target_names}")
print("\nInterpretación del gráfico:")
print("- Cada punto representa la media de una característica para una clase")
print("- Las barras verticales representan ±1 desviación estándar")
print("- Permite visualizar qué características discriminan mejor entre clases")




















